# 配置契约示例，无真实值。当前边界只允许在项目内准备，不读取项目外配置。
# 此示例仅供人工填写项目内 .runtime/runtime.env；禁止直接用于生产启动。
APP_VERSION=2.0.0-dev
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3003

# 直连数据库必须校验TLS；旧无TLS数据库仅可经过已验证主机密钥的内部SSH隧道。
# 迁移账号应与运行账号分离；不要给普通服务旧库结构删除权限。
DATABASE_URL=postgresql://replace-user:replace-password@storage-tunnel:15432/replace-database
DATABASE_MIGRATION_URL=postgresql://replace-migration-user:replace-password@storage-tunnel:15432/replace-database
DATABASE_TRANSPORT=ssh
STORAGE_TUNNEL_DIRECTORY=./.runtime/tunnel

# 对象存储继续使用原HTTPS端点，CA校验贯穿限定CONNECT代理。
# 只向S3客户端配置代理，禁止设置影响采集/模型请求的全局HTTPS_PROXY。
S3_ENDPOINT_URL=https://storage.example.invalid:9000
S3_ACCESS_KEY=replace-with-existing-access-key
S3_SECRET_KEY=replace-with-existing-secret
S3_BUCKET=replace-with-existing-bucket
S3_REGION=us-east-1
S3_CA_FILE=./.runtime/s3-ca.crt
LEYU_SIGNING_FILE=./.runtime/leyu-app-signing.json
LEYU_DISCOVERY_FILE=./.runtime/leyu-app-discovery.json

# 新平台密钥只保护新数据，不替代旧会话加密主密钥。
APP_SESSION_SECRET=generate-32-random-bytes-as-hex
DATA_ENCRYPTION_KEY=generate-32-random-bytes-as-hex
EXPERT_MCP_TOKEN=generate-random-service-token
COLLECTOR_INTERNAL_TOKEN=generate-random-collector-token
EXECUTOR_INTERNAL_TOKEN=generate-independent-executor-token
LIVE_ORDERS_ENABLED=false
EXECUTOR_LIVE_ORDERS_ENABLED=false
HERMES_API_KEY=generate-random-internal-api-token
HERMES_PROVIDER_BASE_URL=https://model.example.invalid/v1
HERMES_PROVIDER_API_KEY=replace-with-existing-provider-key
HERMES_MODEL=cline-pass/deepseek-v4.1-flash

BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=generate-a-unique-password
BOOTSTRAP_ADMIN_TOTP_SECRET=generate-base32-totp-secret
COOKIE_SECURE=true
QUOTE_MAX_AGE_SECONDS=15
REVIEW_REALTIME_WINDOW_SECONDS=86400
REVIEW_REALTIME_CLAIMS_PER_REPLAY=8
REVIEW_HISTORICAL_CONCURRENCY=1
REVIEW_WORKER_CONCURRENCY=2
