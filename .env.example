# Copy values into an external, owner-readable runtime secret file.
PG_BASE_URL=replace-with-remote-postgres-host
PG_BASE_PORT=5432
PG_USER=replace-with-dedicated-v2-database-user
PG_PASSWORD=replace-with-database-secret
PG_DATASET=replace-with-database-name
APP_SESSION_SECRET=generate-32-random-bytes-as-hex
DATA_ENCRYPTION_KEY=generate-32-random-bytes-as-hex
EXPERT_MCP_TOKEN=generate-random-service-token
COLLECTOR_INTERNAL_TOKEN=generate-random-collector-token
HERMES_API_KEY=generate-random-hermes-api-token
HERMES_PROVIDER_BASE_URL=https://replace-with-openai-compatible-endpoint/v1
HERMES_PROVIDER_API_KEY=replace-with-provider-secret
HERMES_MODEL=cline-pass/deepseek-v4.1-flash
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=generate-a-unique-password
BOOTSTRAP_ADMIN_TOTP_SECRET=generate-base32-totp-secret
